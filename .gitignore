# Ambiente virtual (é recriado a partir do requirements.txt)
.venv/

# Dados sensíveis: token do Telegram e Chat ID para testes locais
.env

# Arquivos gerados automaticamente pelo Python
__pycache__/
*.pyc

# Arquivo temporário da gravação segura do histórico
*.tmp

# Configurações pessoais do editor
.vscode/

# Saídas de testes manuais
*.log
teste_*.txt
teste_*.json